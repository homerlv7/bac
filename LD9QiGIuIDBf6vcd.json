43f-4741-8d8c-0f1ad331151e","name":"pega insta1"},{"parameters":{"jsCode":"// Esse código deve rodar em um nó Code (Run Once for All Items)\n\nconst output = [];\n\n// $input.all() traz todos os items que chegaram até aqui\nfor (const item of $input.all()) {\n  // Supondo que seu JSON original está em item.json\n  const lista = item.json.data || [];\n  \n  for (const registro of lista) {\n    const contato = registro.contact || {};\n    // Pega o nome e remove espaços extras\n    const nome  = contato.name   ? contato.name.trim()               : null;\n    // Pega o telefone e tira tudo que não for dígito\n    const phone = contato.phone  ? contato.phone.replace(/\\D/g, '')  : null;\n    \n    // Só inclui se existir pelo menos um dos dois\n    if (nome || phone) {\n      output.push({\n        json: {\n          name:  nome,\n          phone: phone\n        }\n      });\n    }\n  }\n}\n\nreturn output;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-2040,-1620],"id":"323da40f-0bf8-4dce-9a23-cb7bd140fba0","name":"Code"},{"parameters":{},"type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[-2420,-1620],"id":"72328a82-027b-4e45-a4da-e257b5a41a01","name":"When clicking ‘Test workflow’"},{"parameters":{"jsCode":"// Mode: Run Once for Each Item\n// Versão mais direta possível\n\n// Remove tudo exceto números\nconst num = $json.phone.replace(/\\D/g, '');\n\n// Se tem 55 no início e apenas 11 dígitos total (55 + 9), adiciona 11\nif (num.length === 11 && num.startsWith('55')) {\n    $json.phone = '+5511' + num.substring(2);\n}\n// Se já está completo, apenas garante o +\nelse if (num.startsWith('55')) {\n    $json.phone = '+' + num;\n}\n// Se não tem 55, adiciona +5511\nelse if (num.length <= 9) {\n    $json.phone = '+5511' + num;\n}\n\nreturn $json;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1920,-580],"id":"83946f42-df02-4e02-acf5-83c73fb52af0","name":"Code1"},{"parameters":{"amount":1,"unit":"minutes"},"type":"n8n-nodes-base.wa