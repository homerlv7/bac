${formatMoney(valorRecebido)}\n📋 Referência: ${dados.external_reference}\n🕐 Criado: ${dataCriada}\n💰 Pago: ${dataPagamento}\n✨ Status: CREDITADO\n\n🎉 Pagamento processado com sucesso!`;\n\n} else if (dados.status === 'pending' && dados['aprovado '] === 'pending' && !dados['data do pagamento']) {\n    // PIX PENDENTE\n    tipo = 'PENDENTE';\n    status = 'AGUARDANDO';\n    \n    const valor = dados.transaction_details?.total_paid_amount;\n    const dataCriada = formatDate(dados['data criada pagamento']);\n    \n    mensagem = `🔥 NOVO PIX GERADO!\n\n💰 Valor: ${formatMoney(valor)}\n📋 Referência: ${dados.external_reference}\n🕐 Criado: ${dataCriada}\n⏳ Status: AGUARDANDO PAGAMENTO\n\n💡 PIX aguardando transferência do cliente!`;\n\n} else {\n    // OUTROS\n    tipo = 'OUTRO';\n    status = 'NAO_IDENTIFICADO';\n    \n    mensagem = `ℹ️ STATUS NÃO IDENTIFICADO\n\n📊 Status: ${dados.status}\n✅ Aprovado: ${dados['aprovado ']}\n📋 Ref: ${dados.external_reference}\n\n⚠️ Este PIX não se enquadra nos critérios.`;\n}\n\n// Resultado final\nconst resultado = {\n    tipo: tipo,\n    status: status,\n    mensagem: mensagem,\n    referencia: dados.external_reference,\n    processadoEm: new Date().toISOString()\n};\n\nconsole.log(`🔍 Tipo: ${tipo}`);\nconsole.log(`📱 Mensagem:`);\nconsole.log(mensagem);\n\nreturn [{ json: resultado }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1360,520],"id":"999691bb-5d2f-4e9f-8ee5-f76caa47d334","name":"Code3"},{"parameters":{"resource":"messages-api","instanceName":"hub","remoteJid":"120363401362568133@g.us","messageText":"={{ $item(\"0\").$node[\"Code3\"].json[\"mensagem\"] }}","options_message":{}},"type":"n8n-nodes-evolution-api.evolutionApi","typeVersion":1,"position":[1500,520],"id":"bb8da4a1-96aa-459a-8f23-df29983a0c03","name":"Evolution API2","credentials":{"evolutionApi":{"id":"MPRDis1ZUbsDftYZ","name":"global key"}}},{"parameters":{"method":"POST","url":"https://api.mercadopago.com/checkout/preferences","sendHeaders":true,"heade