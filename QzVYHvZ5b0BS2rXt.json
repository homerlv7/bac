\n        // Tentar encontrar os dados em outras estruturas possíveis\n        const possibleData = findLocalResults(jsonData);\n        if (possibleData) {\n          return extractClinicData(possibleData);\n        }\n        \n        // Se nada funcionar, retornar um erro como item\n        return [{\n          error: true,\n          message: 'Estrutura de dados inválida: local_results não encontrado',\n          originalData: jsonData\n        }];\n      }\n    }\n    \n    // Se chegou aqui, encontrou local_results diretamente\n    return extractClinicData(jsonData.local_results);\n    \n  } catch (error) {\n    // Em caso de erro, retornar um item com informações do erro\n    return [{\n      error: true,\n      message: `Erro ao processar dados: ${error.message}`,\n      stack: error.stack\n    }];\n  }\n}\n\n// Função para encontrar local_results em diferentes níveis da estrutura\nfunction findLocalResults(data) {\n  // Se for um objeto, verificar suas propriedades\n  if (data && typeof data === 'object' && !Array.isArray(data)) {\n    // Verificar se tem local_results\n    if (data.local_results && Array.isArray(data.local_results)) {\n      return data.local_results;\n    }\n    \n    // Verificar em cada propriedade\n    for (const key in data) {\n      const result = findLocalResults(data[key]);\n      if (result) return result;\n    }\n  }\n  \n  // Se for um array, verificar cada elemento\n  if (Array.isArray(data)) {\n    for (const item of data) {\n      const result = findLocalResults(item);\n      if (result) return result;\n    }\n  }\n  \n  return null;\n}\n\n// Função para extrair e formatar os dados das clínicas\nfunction extractClinicData(localResults) {\n  return localResults.map(clinica => ({\n    name: clinica.title || '',\n    endereco: clinica.address || '',\n    telefone: clinica.phone || '',\n    rating: clinica.rating || '',\n    reviews: clinica.reviews || '', \n    website: clinica.website || '',\n    // Adicionar o campo types como uma string separada por vírgulas\n    types: Array.isArray(clinica.types) ? clinica.types.join(', ') : ''\n  }));\n}\n\n// Processar todos os itens de entrada\n// Esta é a forma que o N8N espera receber os resultados\nreturn items.map(processData).flat();"},"id":"a6f8520e-483d-4a81-9d40-8e49c8da0e77","name":"Extrai dados","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,280]},{"parameters":{"url":"https://serpapi.com/search","sendQuery":true,"queryParameters":{"parameters":[{"name":"engine","value":"google_maps"},{"name":"q","value":"={{ $item(\"0\").$node[\"n8n Form Trigger\"].json[\"O que você deseja encontrar?\"] }}"},{"name":"api_key","value":"4f63919479e8e17b7b02159244c736957b31929956c24705373dd8705edd4557"},{"name":"start","value":"={{ $item(\"0\").$node[\"Loop Over Items1\"].json[\"start\"] }}"},{"name":"ll","value":"={{ $item(\"0\").$node[\"OpenAI\"].json[\"message\"][\"content\"][\"ll\"] }}"}]},"options":{}},"id":"e7de460d-d946-4b28-a4e2-0f219e38b35e","name":"Busca na SerpAPI1","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-20,240]},{"parameters":{"jsCode":"// Gera um array de números de 0 a 1000 em incrementos de 10\nconst dezenas = Array.from({ length: 6 }, (_, i) => i * 20);\n\n// Retorna um objeto onde cada número gerado é um item individual\nreturn dezenas.map(num => ({ start: num }));"},"id":"a1a56995-4d8a-4729-84b3-62a3a09a1d2b","name":"Code","type":"n8n-nodes-base.code","typeVersion":2,"position":[-520,200]},{"parameters":{"options":{"reset":"={{ $node[\"Loop Over Items1\"].context[\"done\"]}}"}},"id":"78ecbe07-e712-4e66-862b-5497f82472a4","name":"Loop Over Items1","type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[-280,200]},{"parameters":{"amount":3},"id":"04065030-027d-42b7-a829-ca7707ebdf39","name":"Wait","type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[2460,660],"webhookId":"1b056551-af12-4581-8d6b-1fd4c5c13bc1"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":